@inject PlaybackState Playback
@inject AudioEngineService AudioEngine
@implements IAsyncDisposable

<section id="visualizer" class="relative overflow-hidden bg-[#05003a] px-4 pb-20 pt-12 md:px-8 md:pb-24 md:pt-16">
    <div class="relative mx-auto max-w-6xl overflow-hidden rounded-[2rem] border border-white/20 bg-[#090f2d] shadow-[0_26px_80px_rgba(0,0,0,0.48)]">
        <div class="absolute inset-0 z-0">
            <canvas @ref="_canvas" class="h-full w-full" aria-hidden="true"></canvas>
            <div class="pointer-events-none absolute inset-0" style="background: linear-gradient(180deg, rgba(255,255,255,0.08) 0%, rgba(15,18,42,0.12) 28%, rgba(11,8,35,0.42) 100%);"></div>
        </div>

        <div class="relative z-10 flex min-h-[28rem] flex-col justify-between px-3 pb-24 pt-8 md:min-h-[40rem] md:px-6 md:pb-28 md:pt-10">
            <div class="mx-auto inline-flex items-center rounded-full border border-white/30 bg-black/25 px-4 py-2 backdrop-blur-xl md:px-5">
                <span class="text-[0.6rem] font-black uppercase tracking-[0.28em] text-white md:text-[0.65rem]">
                    <span class="text-white">Jam</span><span class="text-white/70">Music</span>
                </span>
            </div>

            <PlayerBar Track="Playback.Track" />
        </div>

        <audio @ref="_audio" preload="metadata"></audio>
    </div>
</section>

@code {
    private ElementReference _audio;
    private ElementReference _canvas;

    protected override void OnInitialized()
    {
        Playback.Changed += OnPlaybackChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await AudioEngine.InitializeAsync(_audio, _canvas);
        }
    }

    private void OnPlaybackChanged() => InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        Playback.Changed -= OnPlaybackChanged;
        await AudioEngine.StopAsync();
    }
}
