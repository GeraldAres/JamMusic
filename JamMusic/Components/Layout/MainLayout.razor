@inherits LayoutComponentBase

<div class="min-h-screen bg-jamBlack text-jamWhite">
    <main class="min-h-screen">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet class="fixed bottom-0 left-0 z-50 hidden w-full bg-[#fff8c4] px-5 py-3 text-sm text-slate-900 shadow-[0_-1px_2px_rgba(0,0,0,0.2)]">
    <div class="flex items-center justify-between gap-4">
        <div class="flex items-center gap-3">
            <span class="font-medium">An unhandled error has occurred.</span>
            <a href="." class="reload font-semibold underline">Reload</a>
        </div>
        <span class="dismiss cursor-pointer text-lg">🗙</span>
    </div>
</div>
