<script type="module" src="@Assets["Components/Layout/ReconnectModal.razor.js"]"></script>

<dialog id="components-reconnect-modal" data-nosnippet class="m-0 border-0 bg-white p-0 opacity-0">
    <div class="components-reconnect-container flex flex-col items-center gap-4">
        <div class="components-rejoining-animation relative h-20 w-20" aria-hidden="true">
            <div></div>
            <div></div>
        </div>
        <p class="components-reconnect-first-attempt-visible text-center text-sm text-slate-700">
            Rejoining the server...
        </p>
        <p class="components-reconnect-repeated-attempt-visible text-center text-sm text-slate-700">
            Rejoin failed... trying again in <span id="components-seconds-to-next-attempt"></span> seconds.
        </p>
        <p class="components-reconnect-failed-visible text-center text-sm text-slate-700">
            Failed to rejoin.<br />Please retry or reload the page.
        </p>
        <button id="components-reconnect-button" class="components-reconnect-failed-visible rounded bg-[#6b9ed2] px-6 py-1.5 text-sm font-medium text-white transition hover:bg-[#3b6ea2]">
            Retry
        </button>
        <p class="components-pause-visible text-center text-sm text-slate-700">
            The session has been paused by the server.
        </p>
        <p class="components-resume-failed-visible text-center text-sm text-slate-700">
            Failed to resume the session.<br />Please retry or reload the page.
        </p>
        <button id="components-resume-button" class="components-pause-visible components-resume-failed-visible rounded bg-[#6b9ed2] px-6 py-1.5 text-sm font-medium text-white transition hover:bg-[#3b6ea2]">
            Resume
        </button>
    </div>
</dialog>
